//@version=6
strategy("TradeVivo · SMT + CISD + FVG", shorttitle = "TV SMT v35", overlay = true,
     pyramiding = 0, initial_capital = 50000, default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.5, slippage = 1,
     margin_long = 0, margin_short = 0,
     max_bars_back = 2000, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ════════════════════════════════════════════════════════════════════
//  המודל
//  1. SMT מול נכס/י השוואה (ברירת מחדל MES1!) — בטיימפריים של המודל (5 דק')
//  2. CISD חיצוני — שבירת השפל שבין שני השיאים (או השיא שבין שני השפלים)
//  3. כניסה בלימיט ב-FVG של גרף הדקה, סטופ מעבר לשיא/שפל ה-SMT
//  יש להריץ על גרף דקה (או 5 דקות) של הנכס הנסחר (למשל MNQ1! או NQ1!)
// ════════════════════════════════════════════════════════════════════

// ───────────── קבועים ─────────────
string DIR_BOTH   = "לונג ושורט"
string DIR_LONG   = "לונג בלבד"
string DIR_SHORT  = "שורט בלבד"
string ENG_LIVE   = "חי (5 דק'): נכס ההשוואה שובר שיא והנכס שלי לא"
string ENG_LUX    = "LuxAlgo (פיבוט בשני הנכסים)"
string ENG_WIN    = "חלון (גמיש)"
string SMT_BOTH   = "שני הכיוונים"
string SMT_WEAK   = "רק הנכס שלי לא שובר"
string CISD_1M    = "סגירת נר דקה"
string CISD_BODY  = "סגירת נר 5 דק'"
string CISD_WICK  = "פתיל"
string CDEF_LOW   = "השפל/שיא בין שני הקיצונים"
string CDEF_ICT   = "פתיחת רצף הנרות שהוביל לקיצון (ICT)"
string PICK_NEAR  = "הקרוב למחיר"
string PICK_SWING = "העליון ביותר (הקרוב לשיא/שפל)"
string PICK_BIG   = "הגדול ביותר"
string PICK_MID   = "האמצעי"
string EDGE_NEAR  = "קצה קרוב"
string EDGE_MID   = "אמצע (50%)"
string EDGE_FAR   = "קצה רחוק"
string STOP_NORM  = "רגיל: מעבר לשיא/שפל ה-SMT"
string STOP_STRUCT = "מבנה אחד מעבר לשיא/שפל ה-SMT"
string ENT_1M     = "גרף דקה"
string ENT_MODEL  = "גרף 5 דק' (טיימפריים המודל)"
string WIN_MODEL  = "נרות של טיימפריים המודל (5 דק')"
string WIN_CHART  = "נרות דקה"
string WIN_OFF    = "ללא הגבלה"
string WHY_NOFVG  = "אין FVG מתאים בחלון שאחרי ה-SMT"
string WHY_SESS   = "מחוץ לסשן"
string RND_NEAR   = "לקרוב ביותר (3.5 → 4, 2.4 → 2)"
string RND_UP     = "תמיד למעלה (2.1 → 3)"
string RND_DOWN   = "תמיד למטה (2.9 → 2)"

string G1 = "כללי"
string G2 = "SMT (טיימפריים המודל)"
string G3 = "CISD (טיימפריים המודל)"
string G4 = "כניסה — FVG (גרף הדקה)"
string G5 = "סיכון"
string G6 = "יעדים לפי RR"
string G7 = "קידום סטופ לפי RR"
string G8 = "מגבלות"
string G9 = "סשנים"
string G10 = "תצוגה"

// ───────────── הגדרות ─────────────
dirMode  = input.string(DIR_BOTH, "כיוון מסחר", options = [DIR_BOTH, DIR_LONG, DIR_SHORT], group = G1)
modelTf  = input.timeframe("5", "טיימפריים של המודל (SMT + CISD)", group = G1)

cmp1On   = input.bool(true, "", inline = "c1", group = G2)
cmp1     = input.symbol("CME_MINI:MES1!", "נכס השוואה 1", inline = "c1", group = G2)
cmp2On   = input.bool(false, "", inline = "c2", group = G2)
cmp2     = input.symbol("CME_MINI:MNQ1!", "נכס השוואה 2", inline = "c2", group = G2)
pivL     = input.int(6, "Pivot — נרות משמאל", minval = 1, group = G2)
pivR     = input.int(6, "Pivot — נרות מימין (אישור)", minval = 1, group = G2, tooltip = "כמה נרות 5 דק' אחרי השיא צריך כדי לאשר אותו. LuxAlgo מצייר את ה-SMT אחורה על השיא, אבל בזמן אמת הוא יודע עליו רק אחרי הנרות האלה: 6 = חצי שעה אחרי השיא, 2 = 10 דקות. מספר קטן = SMT מוקדם יותר (ויותר רעש).")
smtEngine = input.string(ENG_LIVE, "שיטת זיהוי SMT", options = [ENG_LIVE, ENG_LUX, ENG_WIN], group = G2, tooltip = "חי (5 דק'): SMT מזוהה בסגירת נר 5 דק' שבו נכס ההשוואה (MES) שבר שיא/שפל קודם והנכס שלי לא — בלי לחכות לאישור פיבוט.\nLuxAlgo: זהה לאינדיקטור SMT Divergences — SMT רק כששני הנכסים עשו פיבוט באותו נר.\nחלון: משווה לשיא/שפל של נכס ההשוואה בחלון הפיבוט — מזהה יותר SMT-ים, גם כשבנכס ההשוואה אין פיבוט מלא.")
maxDist  = input.int(100, "מרחק מקס' בין שני השיאים (נרות)", minval = 3, group = G2, tooltip = "ב-LuxAlgo אין מגבלה. מספר נמוך יותר = רק SMT-ים בין שיאים קרובים.")
smtMode  = input.string(SMT_BOTH, "סוג SMT", options = [SMT_BOTH, SMT_WEAK], group = G2, tooltip = "שני הכיוונים: כל אחד מהנכסים יכול להיות זה שנכשל (מומלץ).\nרק הנכס שלי לא שובר: בשורט — MNQ לא עבר את השיא ו-MES כן. בלונג — MNQ לא שבר את השפל ו-MES כן. כש-NQ חלש מ-ES זה כמעט לא נותן לונגים.")

cisdMode = input.string(CISD_BODY, "שבירת CISD לפי", options = [CISD_1M, CISD_BODY, CISD_WICK], group = G3, tooltip = "סגירת נר דקה: מספיק שנר דקה נסגר מעבר לקו.\nסגירת נר 5 דק': צריך נר 5 דקות שנסגר מעבר לקו.\nפתיל: מספיק שהמחיר נגע מעבר לקו.")
cisdDef  = input.string(CDEF_ICT, "רמת ה-CISD", options = [CDEF_LOW, CDEF_ICT], group = G3, tooltip = "השפל/שיא בין שני הקיצונים: בשורט — השפל הנמוך ביותר בין השיא הקודם לשיא ה-SMT.\nICT: בשורט — הפתיחה של הנר הראשון ברצף הנרות העולים שהוביל לשיא ה-SMT (בלונג — רצף הנרות היורדים שהוביל לשפל). בדרך כלל קרוב יותר לקיצון, ולכן נשבר מוקדם יותר.\nעובד עם מנוע ה-SMT החי.")
needCisd = input.bool(true, "חובה לחכות ל-CISD לפני הכניסה", group = G3, tooltip = "כבוי: האסטרטגיה שמה לימיט ב-FVG מיד אחרי ה-SMT, בלי לחכות לשבירת ה-CISD.")
cisdWait = input.int(12, "זמן מקס' לשבירת CISD (נרות מודל)", minval = 1, group = G3)

entryTf   = input.string(ENT_1M, "גרף הכניסה (ה-FVG)", options = [ENT_1M, ENT_MODEL], group = G4, tooltip = "על איזה גרף מחפשים את ה-FVG של הכניסה.\nגרף דקה: FVG מנרות דקה.\nגרף 5 דק': FVG מנרות 5 דקות (החלון של X נרות נספר גם הוא בנרות 5 דקות). הלימיט עדיין מתמלא לפי נרות הדקה, כך שהמילוי מדויק.\nעל גרף 5 דקות שתי האפשרויות זהות (ה-FVG תמיד מנרות 5 דקות).")
fvgCisd   = input.bool(true, "קבל גם FVG מהתזוזה ששברה את ה-CISD", group = G4, tooltip = "בנוסף ל-FVG שנוצר X נרות אחרי נר ה-SMT — גם FVG שנוצר בנר ה-5 דקות ששבר את ה-CISD או ב-X הנרות שאחריו.")
fvgPick   = input.string(PICK_MID, "איזה FVG", options = [PICK_MID, PICK_SWING, PICK_NEAR, PICK_BIG], group = G4, tooltip = "מבין ה-FVG-ים שנוצרו בתנועה מהשיא (בשורט) או מהשפל (בלונג):\nהאמצעי: עם 3 FVG-ים בוחר את האמצעי, עם 2 את העליון (בשורט).\nהעליון ביותר: הכי קרוב לשיא/שפל של ה-SMT.\nהקרוב למחיר: הראשון שהמחיר יגיע אליו.")
fvgEdge   = input.string(EDGE_NEAR, "נקודת כניסה ב-FVG", options = [EDGE_NEAR, EDGE_MID, EDGE_FAR], group = G4)
fvgWin    = input.int(4, "FVG רק בתוך X נרות אחרי נר ה-SMT", minval = 1, group = G4, tooltip = "ה-FVG של הכניסה חייב להיווצר בנר של ה-SMT או ב-X הנרות שאחריו.")
fvgWinTf  = input.string(WIN_CHART, "סוג הנרות לחלון", options = [WIN_MODEL, WIN_CHART, WIN_OFF], group = G4, tooltip = "נרות 5 דק': X נרות של 5 דקות אחרי נר ה-SMT.\nנרות דקה: X נרות של דקה אחרי נר הדקה שעשה את השיא/שפל.")
fvgMinT   = input.int(2, "גודל FVG מינ' (טיקים)", minval = 1, group = G4)
mitType   = input.string("Close", "Mitigation Type", options = ["Close", "Wick"], inline = "mit", group = G4)
mitPct    = input.float(50, "Mitigation %", minval = 0, maxval = 100, inline = "mit", group = G4, tooltip = "כמו ב-Panda Zones: FVG נפסל כשנר נסגר (Close) או נוגע בפתיל (Wick) מעבר לאחוז הזה מגודל ה-FVG. 50 = חצי, 100 = הקצה הרחוק.")
usePD     = input.bool(false, "רק FVG ב-Premium / Discount של התנועה", group = G4, tooltip = "בשורט: נקודת הכניסה מעל 50% של התנועה משיא ה-SMT עד השפל שאחריו. בלונג: מתחת ל-50%.")
entryWait = input.int(60, "זמן מקס' לכניסה אחרי CISD (דקות)", minval = 1, group = G4)
cancelTgt = input.bool(true, "ביטול אם המחיר הגיע ליעד לפני הכניסה", group = G4)

riskUsd  = input.float(250, "סיכון קבוע לעסקה ($)", minval = 1, group = G5)
qtyRound = input.string(RND_NEAR, "עיגול מספר החוזים", options = [RND_NEAR, RND_UP, RND_DOWN], group = G5, tooltip = "מספר החוזים = סיכון $ ÷ (מרחק הסטופ × שווי נקודה). כשיוצא מספר לא שלם, כך הוא מעוגל. עיגול למעלה יכול לסכן קצת יותר מהסכום שהוגדר.")
maxQty   = input.int(10, "מקסימום חוזים", minval = 1, group = G5)
slBuf    = input.int(2, "מרווח סטופ מעבר לשיא/שפל (טיקים)", minval = 0, group = G5)
slMinT   = input.int(8, "סטופ מינימלי (טיקים)", minval = 1, group = G5)
slMaxT   = input.int(1000, "סטופ מקסימלי (טיקים)", minval = 1, group = G5)
stopB    = input.string(STOP_STRUCT, "סטופ כשנאסד\"ק לקח את הנזילות ו-MES לא", options = [STOP_NORM, STOP_STRUCT], group = G5, tooltip = "לונג: MNQ שבר את השפל ו-MES לא. שורט: MNQ שבר את השיא ו-MES לא.\nבמקרים האלה נאסד\"ק עלול להמשיך ולקחת את הסטופ, אז הסטופ יכול לשבת מבנה אחד מעבר: השפל (בלונג) / השיא (בשורט) הקודם בגרף 5 דקות שנמצא מעבר לשפל/שיא ה-SMT. הסיכון בדולרים לא משתנה — פשוט פחות חוזים.\nאם אין מבנה כזה — סטופ רגיל.")
structK  = input.int(3, "גודל מבנה (נרות 5 דק' מכל צד)", minval = 1, group = G5, tooltip = "שפל/שיא נחשב מבנה אם הוא הנמוך/הגבוה ביותר מבין X נרות 5 דקות מכל צד שלו.")

tp1RR  = input.float(1.0, "TP1 — RR", minval = 0.1, step = 0.1, inline = "tp1", group = G6)
tp1Pct = input.float(0, "% לסגירה", minval = 0, maxval = 100, inline = "tp1", group = G6)
tp2RR  = input.float(2.0, "TP2 — RR", minval = 0.1, step = 0.1, inline = "tp2", group = G6)
tp2Pct = input.float(0, "% לסגירה", minval = 0, maxval = 100, inline = "tp2", group = G6)
tp3RR  = input.float(3.0, "TP3 — RR (כל היתרה)", minval = 0.1, step = 0.1, group = G6, tooltip = "TP3 סוגר את כל מה שנשאר אחרי TP1 ו-TP2. ברירת המחדל: 0% ב-TP1 ו-TP2, כלומר כל הפוזיציה יוצאת ב-TP3.")

be1On = input.bool(true, "שלב 1", inline = "be1", group = G7)
be1At = input.float(1.0, "כשמגיעים ל-R", step = 0.1, inline = "be1", group = G7)
be1To = input.float(0.0, "סטופ ל-R", step = 0.1, inline = "be1", group = G7, tooltip = "0 = נקודת הכניסה (Breakeven). 1 = רווח של 1R נעול.")
be2On = input.bool(false, "שלב 2", inline = "be2", group = G7)
be2At = input.float(2.0, "כשמגיעים ל-R", step = 0.1, inline = "be2", group = G7)
be2To = input.float(1.0, "סטופ ל-R", step = 0.1, inline = "be2", group = G7)
be3On = input.bool(false, "שלב 3", inline = "be3", group = G7)
be3At = input.float(3.0, "כשמגיעים ל-R", step = 0.1, inline = "be3", group = G7)
be3To = input.float(2.0, "סטופ ל-R", step = 0.1, inline = "be3", group = G7)

maxSess  = input.int(20, "מקס' עסקאות לסשן", minval = 1, group = G8)
maxDay   = input.int(20, "מקס' עסקאות ליום", minval = 1, group = G8)
maxWeek  = input.int(100, "מקס' עסקאות לשבוע", minval = 1, group = G8)
maxMonth = input.int(400, "מקס' עסקאות לחודש", minval = 1, group = G8)
maxLoss  = input.float(0, "מקס' הפסד יומי ($)  0 = ללא", minval = 0, group = G8)
maxProf  = input.float(0, "מקס' רווח יומי ($)  0 = ללא", minval = 0, group = G8)
maxWinD  = input.int(0, "מקס' עסקאות מנצחות ביום  0 = ללא", minval = 0, group = G8, tooltip = "אחרי X עסקאות ברווח באותו יום — לא נכנסים יותר עד מחר. עסקה עם יציאות חלקיות נספרת פעם אחת, לפי הרווח הכולל שלה.")
maxLossD = input.int(0, "מקס' עסקאות מפסידות ביום  0 = ללא", minval = 0, group = G8, tooltip = "אחרי X עסקאות בהפסד באותו יום — לא נכנסים יותר עד מחר. עסקה שנסגרה באפס (ברייק-איבן) לא נספרת.")
closeLim = input.bool(true, "סגור פוזיציה פתוחה כשמגיעים למגבלה היומית", group = G8)

tz   = input.string("Asia/Jerusalem", "אזור זמן (שעון ישראל)", group = G9, tooltip = "כל שעות הסשנים לפי אזור הזמן הזה. Asia/Jerusalem = שעון ישראל, America/New_York = שעון ניו יורק.")
s1On = input.bool(true,  "סשן 1 · כל היום", inline = "s1", group = G9)
s1   = input.session("0130-2300", "", inline = "s1", group = G9)
s2On = input.bool(false, "סשן 2 · אסיה", inline = "s2", group = G9)
s2   = input.session("0130-0900", "", inline = "s2", group = G9)
s3On = input.bool(false, "סשן 3 · לונדון", inline = "s3", group = G9)
s3   = input.session("0900-1530", "", inline = "s3", group = G9)
s4On = input.bool(false, "סשן 4 · ניו יורק בוקר", inline = "s4", group = G9)
s4   = input.session("1630-1830", "", inline = "s4", group = G9)
s5On = input.bool(false, "סשן 5 · ניו יורק צהריים", inline = "s5", group = G9)
s5   = input.session("1830-2300", "", inline = "s5", group = G9)
flatEnd = input.bool(false, "סגור פוזיציה בסוף הסשן", group = G9)

showDraw = input.bool(true, "הצג SMT / CISD / FVG על הגרף", group = G10)
showPos  = input.bool(true, "הצג כלי פוזיציה על כל עסקה", group = G10, tooltip = "כמו כלי הפוזיציה של טריידינג ויו: אדום מהכניסה לסטופ, ירוק מהכניסה ליעד האחרון, מזמן הכניסה עד היציאה. הסטופ המצויר הוא הסטופ ההתחלתי.")
showFail = input.bool(false, "הצג גם SMT-ים שלא הגיעו ל-CISD", group = G10, tooltip = "כבוי: על הגרף נשארים רק סטאפים שעברו CISD — פחות רעש. המונים בטבלה סופרים הכל.")
showTbl  = input.bool(true, "הצג טבלת סטטוס", group = G10)

// רשומת שיא/שפל עבור זיהוי SMT חי
type Piv
    float px
    int   t
    float c1
    float c2
    float ext
    int   extT
    float x1
    float x2
    float run
    float cis
    float ict
    bool  used    = false
    float usedExt
    bool  dead    = false
    bool  again   = false
    int   fires   = 0

// ───────────── נתוני המודל (5 דק') — ללא ריפיינט ─────────────
// כל הערכים מוחזרים מהנר הסגור האחרון של טיימפריים המודל ([1] + lookahead_on).
// כשהגרף עצמו על טיימפריים המודל (5 דק') — o = 0: הנר הנוכחי, שנסגר כשהאסטרטגיה מחשבת.
f_model(int L, int R, int o) =>
    float ph   = ta.pivothigh(high, L, R)
    float pl   = ta.pivotlow(low, L, R)
    int   pT   = time[R]
    float minC = ta.lowest(close, R)
    float minL = ta.lowest(low, R)
    float maxC = ta.highest(close, R)
    float maxH = ta.highest(high, R)
    // פתיחת הנר הראשון ברצף הנרות העולים / היורדים האחרון (ל-CISD בשיטת ICT)
    float uro  = ta.valuewhen(close > open and not (close[1] > open[1]), open, 0)
    float dro  = ta.valuewhen(close < open and not (close[1] < open[1]), open, 0)
    [ph[o], pl[o], pT[o], minC[o], minL[o], maxC[o], maxH[o], close[o], high[o], low[o], time[o], uro[o], dro[o], high[o + 2], low[o + 2], time[o + 1]]

// נכס השוואה: פיבוטים (שיטת LuxAlgo) + שיא/שפל בחלון הפיבוט (שיטת חלון)
f_cmp(int L, int R, int o) =>
    float ph = ta.pivothigh(high, L, R)
    float pl = ta.pivotlow(low, L, R)
    float hw = ta.highest(high, L + R + 1)
    float lw = ta.lowest(low, L + R + 1)
    [ph[o], pl[o], hw[o], lw[o], time[o], high[o], low[o]]

bool sameTf = timeframe.in_seconds() == timeframe.in_seconds(modelTf)
int  mOff   = sameTf ? 0 : 1
[mPH, mPL, mPT, mMinC, mMinL, mMaxC, mMaxH, mC, mH, mL, mT, mURO, mDRO, mH3, mL3, mT2] = request.security(syminfo.tickerid, modelTf, f_model(pivL, pivR, mOff), lookahead = barmerge.lookahead_on)
[c1PH, c1PL, c1HiW, c1LoW, c1T, c1H5, c1L5] = request.security(cmp1, modelTf, f_cmp(pivL, pivR, mOff), lookahead = barmerge.lookahead_on)
[c2PH, c2PL, c2HiW, c2LoW, c2T, c2H5, c2L5] = request.security(cmp2, modelTf, f_cmp(pivL, pivR, mOff), lookahead = barmerge.lookahead_on)

bool newHtf = not na(mT) and mT != nz(mT[1])
bool tfOk   = timeframe.in_seconds() <= timeframe.in_seconds(modelTf)
int  tfMs   = timeframe.in_seconds(modelTf) * 1000

// היסטוריית נרות המודל — לחישוב רמת ה-CISD (השפל/שיא שבין שני הפיבוטים)
var array<int>   hT  = array.new<int>()
var array<float> hLo = array.new<float>()
var array<float> hHi = array.new<float>()
if newHtf
    array.push(hT, mT)
    array.push(hLo, mL)
    array.push(hHi, mH)
    if array.size(hT) > 1000
        array.shift(hT)
        array.shift(hLo)
        array.shift(hHi)

// השפל (wantLow) או השיא הקיצוני של נרות המודל שבין t1 ל-t2 (לא כולל)
f_between(int t1, int t2, bool wantLow) =>
    float r = na
    int n = array.size(hT)
    if n > 0 and not na(t1)
        for i = n - 1 to 0
            int t = array.get(hT, i)
            if t <= t1
                break
            if t < t2
                float v = wantLow ? array.get(hLo, i) : array.get(hHi, i)
                r := na(r) ? v : wantLow ? math.min(r, v) : math.max(r, v)
    r

// ───────────── זיהוי SMT ─────────────
// לוגיקת LuxAlgo: SMT רק כששני הנכסים עשו פיבוט באותו נר והכיוונים הפוכים.
// אם הנכס שלי עושה פיבוט קיצוני יותר לבד — נקודת הייחוס מתאפסת.
// מחזיר [divergence, y1 חדש, sym_y1 חדש, x1 חדש]
f_lux(bool isHigh, float y2, int x2, float prevMain, float symY2, float y1, float sy1, int x1) =>
    bool  div  = false
    float ny1  = y1
    float nsy1 = sy1
    int   nx1  = x1
    if not na(symY2)
        div  := not na(y1) and not na(sy1) and (y2 - y1) * (symY2 - sy1) < 0
        ny1  := y2
        nsy1 := symY2
        nx1  := x2
    else if not na(prevMain) and (isHigh ? y2 > prevMain : y2 < prevMain)
        ny1  := y2
        nsy1 := na
        nx1  := x2
    [div, ny1, nsy1, nx1]

bool weak   = smtMode == SMT_WEAK
bool useLux = smtEngine == ENG_LUX

// הפיבוט הקודם של הנכס שלי
var float mLastPH  = na
var int   mLastPHt = na
var float mLastPL  = na
var int   mLastPLt = na
// מצב LuxAlgo לכל נכס השוואה (שיאים / שפלים)
var float lx1yH = na
var float lx1sH = na
var int   lx1xH = na
var float lx1yL = na
var float lx1sL = na
var int   lx1xL = na
var float lx2yH = na
var float lx2sH = na
var int   lx2xH = na
var float lx2yL = na
var float lx2sL = na
var int   lx2xL = na
// מצב שיטת החלון
var float w1H = na
var float w1L = na
var float w2H = na
var float w2L = na

bool  bearSMT = false
bool  bullSMT = false
float smtRef  = na
int   smtRefT = na
float smtCisd = na

if newHtf
    bool al1 = c1T == mT
    bool al2 = c2T == mT
    if not na(mPH)
        bool  d1  = false
        bool  d2  = false
        float r1  = na
        int   r1t = na
        float r2  = na
        int   r2t = na
        if useLux
            r1  := lx1yH
            r1t := lx1xH
            r2  := lx2yH
            r2t := lx2xH
            [hd1, hy1, hs1, hx1] = f_lux(true, mPH, mPT, mLastPH, al1 ? c1PH : na, lx1yH, lx1sH, lx1xH)
            [hd2, hy2, hs2, hx2] = f_lux(true, mPH, mPT, mLastPH, al2 ? c2PH : na, lx2yH, lx2sH, lx2xH)
            d1    := hd1
            d2    := hd2
            lx1yH := hy1
            lx1sH := hs1
            lx1xH := hx1
            lx2yH := hy2
            lx2sH := hs2
            lx2xH := hx2
        else
            r1  := mLastPH
            r1t := mLastPHt
            r2  := mLastPH
            r2t := mLastPHt
            d1  := al1 and not na(mLastPH) and not na(w1H) and (mPH - mLastPH) * (c1HiW - w1H) < 0
            d2  := al2 and not na(mLastPH) and not na(w2H) and (mPH - mLastPH) * (c2HiW - w2H) < 0
            w1H := al1 ? c1HiW : na
            w2H := al2 ? c2HiW : na
        bool use1 = cmp1On and d1
        bool use2 = cmp2On and d2
        if use1 or use2
            float refY = use1 ? r1 : r2
            int   refT = use1 ? r1t : r2t
            float lvl  = f_between(refT, mPT, true)
            bool  ok   = not na(lvl) and mPT - refT <= maxDist * tfMs and (not weak or mPH < refY)
            if ok
                bearSMT := true
                smtRef  := refY
                smtRefT := refT
                smtCisd := lvl
        mLastPH  := mPH
        mLastPHt := mPT
    if not na(mPL)
        bool  d1  = false
        bool  d2  = false
        float r1  = na
        int   r1t = na
        float r2  = na
        int   r2t = na
        if useLux
            r1  := lx1yL
            r1t := lx1xL
            r2  := lx2yL
            r2t := lx2xL
            [ld1, ly1, ls1, lt1] = f_lux(false, mPL, mPT, mLastPL, al1 ? c1PL : na, lx1yL, lx1sL, lx1xL)
            [ld2, ly2, ls2, lt2] = f_lux(false, mPL, mPT, mLastPL, al2 ? c2PL : na, lx2yL, lx2sL, lx2xL)
            d1    := ld1
            d2    := ld2
            lx1yL := ly1
            lx1sL := ls1
            lx1xL := lt1
            lx2yL := ly2
            lx2sL := ls2
            lx2xL := lt2
        else
            r1  := mLastPL
            r1t := mLastPLt
            r2  := mLastPL
            r2t := mLastPLt
            d1  := al1 and not na(mLastPL) and not na(w1L) and (mPL - mLastPL) * (c1LoW - w1L) < 0
            d2  := al2 and not na(mLastPL) and not na(w2L) and (mPL - mLastPL) * (c2LoW - w2L) < 0
            w1L := al1 ? c1LoW : na
            w2L := al2 ? c2LoW : na
        bool use1 = cmp1On and d1
        bool use2 = cmp2On and d2
        if use1 or use2
            float refY = use1 ? r1 : r2
            int   refT = use1 ? r1t : r2t
            float lvl  = f_between(refT, mPT, false)
            bool  ok   = not na(lvl) and mPT - refT <= maxDist * tfMs and (not weak or mPL > refY)
            if ok
                bullSMT := true
                smtRef  := refY
                smtRefT := refT
                smtCisd := lvl
        mLastPL  := mPL
        mLastPLt := mPT

bool useLive = smtEngine == ENG_LIVE
bool useIct  = cisdDef == CDEF_ICT and useLive

// ───────────── מצב הסטאפ ─────────────
// סטאפ: 0 = אין, 1 = ממתין ל-CISD, 2 = ממתין לכניסה ב-FVG
var int   stDir    = 0
var int   stStage  = 0
var float stSwing  = na
var int   stSwingT = na
var float stPrev   = na
var int   stPrevT  = na
var float stCisd   = na
var int   stArmT   = na
var int   stCisdT  = na
var int   stCisdBT = na
var float stStopRef = na
var float stExt    = na
var int   stWinEnd = na
var bool  stLive   = false
var int   stLType  = 0
var float stRun    = na
var line  lnSmt    = na
var label lbSmt    = na
var line  lnCisd   = na
var box   bxFvg    = na
var label lbFvg    = na
var int   bxT0     = na
var int   bxArm    = na


// ───────────── SMT חי ─────────────
// נשמרים השיאים/שפלים האחרונים (פיבוטים של 5 דק') של הנכס שלי, יחד עם השיא/שפל של נכס ההשוואה באותו זמן.
// SMT לשורט: נכס ההשוואה עבר את השיא שלו והנכס שלי עדיין מתחת לשיא שלו (ולהפך ללונג).
// רמת ה-CISD = השפל הנמוך ביותר שבין השיא הקודם לשיא החדש של הנכס שלי.
var array<Piv> pvHs = array.new<Piv>()
var array<Piv> pvLs = array.new<Piv>()

bool  lvBear   = false
float lvBSw    = na
int   lvBSwT   = na
float lvBPrev  = na
int   lvBPrevT = na
float lvBCisd  = na
float lvBRun   = na
int   lvBType  = 0
bool  lvBull   = false
float lvUSw    = na
int   lvUSwT   = na
float lvUPrev  = na
int   lvUPrevT = na
float lvUCisd  = na
float lvURun   = na
int   lvUType  = 0

if useLive and newHtf
    float k1H = c1T == mT ? c1H5 : na
    float k1L = c1T == mT ? c1L5 : na
    float k2H = c2T == mT ? c2H5 : na
    float k2L = c2T == mT ? c2L5 : na
    if not na(mPH)
        float r0 = f_between(mPT, mT, true)
        array.push(pvHs, Piv.new(px = mPH, t = mPT, c1 = c1T == mT ? c1HiW : na, c2 = c2T == mT ? c2HiW : na, run = r0, cis = r0))
        if array.size(pvHs) > 12
            array.shift(pvHs)
    if not na(mPL)
        float r1 = f_between(mPT, mT, false)
        array.push(pvLs, Piv.new(px = mPL, t = mPT, c1 = c1T == mT ? c1LoW : na, c2 = c2T == mT ? c2LoW : na, run = r1, cis = r1))
        if array.size(pvLs) > 12
            array.shift(pvLs)
    // שיאים → SMT לשורט. אם כמה שיאים קודמים נותנים SMT — נבחר הגבוה ביותר (הנזילות המשמעותית).
    // אחרי שהסטאפ/העסקה מול שיא קודם נגמרו, הוא יכול לתת SMT שוב — רק אם נכס ההשוואה שובר אותו שוב והנכס שלי לא.
    if array.size(pvHs) > 0
        int   bestI  = -1
        float bestPx = na
        for i = 0 to array.size(pvHs) - 1
            Piv p = array.get(pvHs, i)
            // סטאפ או עסקה פתוחה מול השיא הזה — לא נוגעים בו עד שייגמרו
            bool active = stPrevT == p.t and ((stStage > 0 and stDir == -1) or strategy.position_size < 0)
            if p.used and not active
                // הסטאפ הקודם מול השיא הזה נגמר — מחפשים מולו שיא חדש, עם שבירה חדשה של נכס ההשוואה
                p.used  := false
                p.again := true
                p.ext   := na
                p.extT  := na
                p.x1    := na
                p.x2    := na
            if na(p.ext) or mH > p.ext
                p.cis  := p.run
                p.ict  := mURO
                p.ext  := mH
                p.extT := mT
            p.run := na(p.run) ? mL : math.min(p.run, mL)
            p.x1  := na(k1H) ? p.x1 : na(p.x1) ? k1H : math.max(p.x1, k1H)
            p.x2  := na(k2H) ? p.x2 : na(p.x2) ? k2H : math.max(p.x2, k2H)
            bool on1    = cmp1On and not na(p.c1)
            bool on2    = cmp2On and not na(p.c2)
            bool sw1    = on1 and p.x1 > p.c1
            bool sw2    = on2 and p.x2 > p.c2
            bool mainSw = p.ext > p.px
            bool typeA  = (sw1 or sw2) and not mainSw
            bool typeB  = not weak and not p.again and mainSw and ((on1 and not sw1) or (on2 and not sw2))
            bool tooOld = mT - p.t > maxDist * tfMs
            bool fresh  = not p.used and p.fires < 3 and (not p.again or mH < p.ext)
            p.dead := tooOld or (mainSw and (weak or p.again or ((not on1 or sw1) and (not on2 or sw2))))
            if not p.dead and (typeA or typeB) and not na(useIct ? p.ict : p.cis) and fresh
                if bestI < 0 or p.px > bestPx
                    bestI  := i
                    bestPx := p.px
        if bestI >= 0
            Piv q = array.get(pvHs, bestI)
            lvBear    := true
            lvBSw     := q.ext
            lvBSwT    := q.extT
            lvBPrev   := q.px
            lvBPrevT  := q.t
            lvBCisd   := useIct ? q.ict : q.cis
            lvBRun    := q.run
            lvBType   := q.ext > q.px ? 2 : 1
            q.used    := true
            q.usedExt := q.ext
            q.fires   += 1
        for i = array.size(pvHs) - 1 to 0
            Piv d = array.get(pvHs, i)
            if d.dead
                array.remove(pvHs, i)
    // שפלים → SMT ללונג (אותו דבר הפוך: נבחר השפל הנמוך ביותר)
    if array.size(pvLs) > 0
        int   bestI  = -1
        float bestPx = na
        for i = 0 to array.size(pvLs) - 1
            Piv p = array.get(pvLs, i)
            bool active = stPrevT == p.t and ((stStage > 0 and stDir == 1) or strategy.position_size > 0)
            if p.used and not active
                p.used  := false
                p.again := true
                p.ext   := na
                p.extT  := na
                p.x1    := na
                p.x2    := na
            if na(p.ext) or mL < p.ext
                p.cis  := p.run
                p.ict  := mDRO
                p.ext  := mL
                p.extT := mT
            p.run := na(p.run) ? mH : math.max(p.run, mH)
            p.x1  := na(k1L) ? p.x1 : na(p.x1) ? k1L : math.min(p.x1, k1L)
            p.x2  := na(k2L) ? p.x2 : na(p.x2) ? k2L : math.min(p.x2, k2L)
            bool on1    = cmp1On and not na(p.c1)
            bool on2    = cmp2On and not na(p.c2)
            bool sw1    = on1 and p.x1 < p.c1
            bool sw2    = on2 and p.x2 < p.c2
            bool mainSw = p.ext < p.px
            bool typeA  = (sw1 or sw2) and not mainSw
            bool typeB  = not weak and not p.again and mainSw and ((on1 and not sw1) or (on2 and not sw2))
            bool tooOld = mT - p.t > maxDist * tfMs
            bool fresh  = not p.used and p.fires < 3 and (not p.again or mL > p.ext)
            p.dead := tooOld or (mainSw and (weak or p.again or ((not on1 or sw1) and (not on2 or sw2))))
            if not p.dead and (typeA or typeB) and not na(useIct ? p.ict : p.cis) and fresh
                if bestI < 0 or p.px < bestPx
                    bestI  := i
                    bestPx := p.px
        if bestI >= 0
            Piv q = array.get(pvLs, bestI)
            lvBull    := true
            lvUSw     := q.ext
            lvUSwT    := q.extT
            lvUPrev   := q.px
            lvUPrevT  := q.t
            lvUCisd   := useIct ? q.ict : q.cis
            lvURun    := q.run
            lvUType   := q.ext < q.px ? 2 : 1
            q.used    := true
            q.usedExt := q.ext
            q.fires   += 1
        for i = array.size(pvLs) - 1 to 0
            Piv d = array.get(pvLs, i)
            if d.dead
                array.remove(pvLs, i)

// ───────────── סשנים ─────────────
f_in(string s) =>
    not na(time(timeframe.period, s, tz))

bool in1 = f_in(s1)
bool in2 = f_in(s2)
bool in3 = f_in(s3)
bool in4 = f_in(s4)
bool in5 = f_in(s5)
int sessIdx = s1On and in1 ? 1 : s2On and in2 ? 2 : s3On and in3 ? 3 : s4On and in4 ? 4 : s5On and in5 ? 5 : 0

// ───────────── מונים ומגבלות ─────────────
var int   cSess    = 0
var int   cDay     = 0
var int   cWeek    = 0
var int   cMonth   = 0
var float dayStart = 0.0
var bool  dayLock  = false
var int   dWin     = 0
var int   dLoss    = 0

if timeframe.change("D")
    cDay     := 0
    dWin     := 0
    dLoss    := 0
    dayStart := strategy.netprofit
    dayLock  := false
if timeframe.change("W")
    cWeek := 0
if timeframe.change("M")
    cMonth := 0
if sessIdx != sessIdx[1] and sessIdx > 0
    cSess := 0

// ───────────── FVG בגרף הדקה ─────────────
var array<float> bTop = array.new<float>()
var array<float> bBot = array.new<float>()
var array<int>   bT   = array.new<int>()
var array<float> uTop = array.new<float>()
var array<float> uBot = array.new<float>()
var array<int>   uT   = array.new<int>()

// Mitigation כמו ב-Panda Zones: FVG נפסל כשהמחיר (סגירה או פתיל) עובר את אחוז ה-Mitigation שלו
// בכניסה מגרף 5 דק': ה-FVG-ים נבנים מנרות 5 הדקות, וגם ה-Mitigation נבדק רק בסגירת נר 5 דקות
bool  ent5   = entryTf == ENT_MODEL
bool  mitNow = not ent5 or newHtf
float mitF   = mitPct / 100
float mitUp  = mitType == "Close" ? (ent5 ? mC : close) : (ent5 ? mH : high)
float mitDn  = mitType == "Close" ? (ent5 ? mC : close) : (ent5 ? mL : low)
if mitNow and array.size(bTop) > 0
    for i = array.size(bTop) - 1 to 0
        float t = array.get(bTop, i)
        float b = array.get(bBot, i)
        if mitUp > b + (t - b) * mitF
            array.remove(bTop, i)
            array.remove(bBot, i)
            array.remove(bT, i)
if mitNow and array.size(uTop) > 0
    for i = array.size(uTop) - 1 to 0
        float t = array.get(uTop, i)
        float b = array.get(uBot, i)
        if mitDn < t - (t - b) * mitF
            array.remove(uTop, i)
            array.remove(uBot, i)
            array.remove(uT, i)

float minGap = fvgMinT * syminfo.mintick
bool newBearF = false
bool newBullF = false
if ent5
    if newHtf and not na(mH3)
        if mH < mL3 and mL3 - mH >= minGap
            newBearF := true
            array.push(bTop, mL3)
            array.push(bBot, mH)
            array.push(bT, mT2)
        if mL > mH3 and mL - mH3 >= minGap
            newBullF := true
            array.push(uTop, mL)
            array.push(uBot, mH3)
            array.push(uT, mT2)
else if bar_index >= 2
    if high < low[2] and low[2] - high >= minGap
        newBearF := true
        array.push(bTop, low[2])
        array.push(bBot, high)
        array.push(bT, time[1])
    if low > high[2] and low - high[2] >= minGap
        newBullF := true
        array.push(uTop, low)
        array.push(uBot, high[2])
        array.push(uT, time[1])
if array.size(bTop) > 300
    array.shift(bTop)
    array.shift(bBot)
    array.shift(bT)
if array.size(uTop) > 300
    array.shift(uTop)
    array.shift(uBot)
    array.shift(uT)

// נקודת הכניסה בתוך FVG לפי ההגדרה
f_lvl(int dir, float t, float b) =>
    float nearE = dir == -1 ? b : t
    float farE  = dir == -1 ? t : b
    fvgEdge == EDGE_NEAR ? nearE : fvgEdge == EDGE_FAR ? farE : (t + b) / 2

// בחירת FVG לכניסה מבין אלה שנוצרו אחרי שיא/שפל ה-SMT.
// הבחירה ננעלת: היא מתעדכנת רק כשנוצר FVG חדש בתנועה (או כשה-FVG הנבחר נפסל),
// ולא זזה כשהמחיר חוזר ופוסל את ה-FVG-ים הקרובים אליו.
f_pick(int dir, array<float> tops, array<float> bots, array<int> ts, float swing, int swingT, int winEnd, float ext, int lockedT, bool repick, int w2s, int w2e) =>
    int n = array.size(tops)
    int bestI = na
    if not repick and not na(lockedT) and n > 0
        for i = 0 to n - 1
            if array.get(ts, i) == lockedT
                float lv = f_lvl(dir, array.get(tops, i), array.get(bots, i))
                if dir == -1 ? lv > close : lv < close
                    bestI := i
                break
    if na(bestI) and n > 0
        float eq = (swing + ext) / 2
        array<int>   idx  = array.new<int>()
        array<float> keys = array.new<float>()
        for i = 0 to n - 1
            float t   = array.get(tops, i)
            float b   = array.get(bots, i)
            float lvl = f_lvl(dir, t, b)
            int  ft    = array.get(ts, i)
            bool inWin = na(winEnd) or ft < winEnd or (not na(w2s) and ft >= w2s and ft < w2e)
            bool inLeg = ft >= swingT and inWin and (dir == -1 ? t <= swing : b >= swing)
            bool ahead = dir == -1 ? lvl > close : lvl < close
            bool pdOk  = not usePD or (dir == -1 ? lvl >= eq : lvl <= eq)
            if inLeg and ahead and pdOk
                array.push(idx, i)
                // מפתח מיון: הגבוה ביותר = הקרוב ביותר לשיא (בשורט), הנמוך ביותר = הקרוב לשפל (בלונג)
                array.push(keys, dir == -1 ? t : -b)
        int m = array.size(idx)
        if m > 0
            if fvgPick == PICK_BIG
                float big = na
                for j = 0 to m - 1
                    int   ii = array.get(idx, j)
                    float sz = array.get(tops, ii) - array.get(bots, ii)
                    if na(big) or sz > big
                        big   := sz
                        bestI := ii
            else
                array<int> ord = array.sort_indices(keys, order.descending)
                int k = fvgPick == PICK_SWING ? 0 : fvgPick == PICK_NEAR ? m - 1 : math.floor((m - 1) / 2)
                bestI := array.get(idx, array.get(ord, k))
    float bestLvl = na
    float bestTop = na
    float bestBot = na
    int   bestT   = na
    if not na(bestI)
        bestTop := array.get(tops, bestI)
        bestBot := array.get(bots, bestI)
        bestT   := array.get(ts, bestI)
        bestLvl := f_lvl(dir, bestTop, bestBot)
    [bestLvl, bestTop, bestBot, bestT]

// ───────────── פקודות ─────────────
f_exits(int dir, float sl, float t1, float t2, float t3, int q1, int q2, int q3, bool done1, bool done2) =>
    string id = dir == 1 ? "Long" : "Short"
    string p  = dir == 1 ? "L" : "S"
    if q1 > 0 and not done1
        strategy.exit(p + "-TP1", id, qty = q1, limit = t1, stop = sl, comment_profit = "TP1", comment_loss = "SL")
    else
        strategy.cancel(p + "-TP1")
    if q2 > 0 and not done2
        strategy.exit(p + "-TP2", id, qty = q2, limit = t2, stop = sl, comment_profit = "TP2", comment_loss = "SL")
    else
        strategy.cancel(p + "-TP2")
    if q3 > 0
        strategy.exit(p + "-TP3", id, qty = q3, limit = t3, stop = sl, comment_profit = "TP3", comment_loss = "SL")
    else
        strategy.cancel(p + "-TP3")
    0

f_cancelSide(int dir) =>
    string p = dir == 1 ? "L" : "S"
    strategy.cancel(dir == 1 ? "Long" : "Short")
    strategy.cancel(p + "-TP1")
    strategy.cancel(p + "-TP2")
    strategy.cancel(p + "-TP3")
    0

// ───────────── מצב ─────────────
// פקודה ממתינה
var int   pDir   = 0
var float pEntry = na
var float pStop  = na
var int   pQty   = 0
var int   pQ1    = 0
var int   pQ2    = 0
var int   pQ3    = 0
var float pT1    = na
var float pT2    = na
var float pT3    = na

// עסקה פתוחה
var int   tDir   = 0
var float tEntry = na
var float tStop  = na
var float tRisk  = na
var int   tQty   = 0
var int   tQ1    = 0
var int   tQ2    = 0
var int   tQ3    = 0
var float tT1    = na
var float tT2    = na
var float tT3    = na
var float tExt   = na
var bool  done1  = false
var bool  done2  = false

// משפך סטאפים — לאבחון
var int nSmt      = 0
var int nCisd     = 0
var int nFilled   = 0
var int nRepl     = 0
var int nCxBeyond = 0
var int nCxCisd   = 0
var int nCxWait   = 0
var int nCxTgt    = 0
var int nNoFvg    = 0
var int nOutSess  = 0
var int nSmtL     = 0
var int nSmtS     = 0
var int nFillL    = 0
var int nFillS    = 0

// ───────────── זיהוי כניסה לעסקה ─────────────
int lastEntryT = 0
if strategy.opentrades > 0
    lastEntryT := strategy.opentrades.entry_time(strategy.opentrades - 1)
if strategy.closedtrades > 0
    lastEntryT := math.max(lastEntryT, strategy.closedtrades.entry_time(strategy.closedtrades - 1))
var int countedT = 0
bool newEntry = lastEntryT > countedT

if newEntry
    countedT := lastEntryT
    nFilled  += 1
    nFillL   += pDir == 1 ? 1 : 0
    nFillS   += pDir == -1 ? 1 : 0
    cSess  += 1
    cDay   += 1
    cWeek  += 1
    cMonth += 1
    tDir   := pDir
    tEntry := pEntry
    tStop  := pStop
    tRisk  := math.abs(pEntry - pStop)
    tQty   := pQty
    tQ1    := pQ1
    tQ2    := pQ2
    tQ3    := pQ3
    tT1    := pT1
    tT2    := pT2
    tT3    := pT3
    tExt   := pEntry
    done1  := false
    done2  := false
    stStage := 0
    stDir   := 0
    alert(str.format("{0} FILLED @ {1} | SL {2} | Qty {3}", tDir == 1 ? "LONG" : "SHORT", str.tostring(tEntry, format.mintick), str.tostring(tStop, format.mintick), tQty), alert.freq_once_per_bar_close)

// כלי פוזיציה על כל עסקה: אדום = כניסה→סטופ, ירוק = כניסה→יעד אחרון
var box pbRed = na
var box pbGrn = na
if newEntry and showPos
    float lastTg = tQ3 > 0 ? tT3 : tQ2 > 0 ? tT2 : tT1
    pbRed := box.new(left = lastEntryT, top = math.max(tEntry, tStop), right = time, bottom = math.min(tEntry, tStop), xloc = xloc.bar_time, bgcolor = color.new(color.red, 75), border_color = color.new(color.red, 40))
    pbGrn := box.new(left = lastEntryT, top = math.max(tEntry, lastTg), right = time, bottom = math.min(tEntry, lastTg), xloc = xloc.bar_time, bgcolor = color.new(color.teal, 75), border_color = color.new(color.teal, 40))
if not na(pbRed) and (strategy.position_size != 0 or strategy.position_size[1] != 0) and not newEntry
    box.set_right(pbRed, time)
    box.set_right(pbGrn, time)

// ───────────── ניהול עסקה: יעדים חלקיים + קידום סטופ ─────────────
if strategy.position_size != 0 and tDir != 0
    int absPos = int(math.abs(strategy.position_size))
    if not done1 and absPos <= tQty - tQ1
        done1 := true
    if not done2 and absPos <= tQty - tQ1 - tQ2
        done2 := true
    if not newEntry
        tExt := tDir == 1 ? math.max(tExt, high) : math.min(tExt, low)
    float curR = tDir * (tExt - tEntry) / tRisk
    if be1On and curR >= be1At
        float ns = tEntry + tDir * be1To * tRisk
        tStop := tDir == 1 ? math.max(tStop, ns) : math.min(tStop, ns)
    if be2On and curR >= be2At
        float ns = tEntry + tDir * be2To * tRisk
        tStop := tDir == 1 ? math.max(tStop, ns) : math.min(tStop, ns)
    if be3On and curR >= be3At
        float ns = tEntry + tDir * be3To * tRisk
        tStop := tDir == 1 ? math.max(tStop, ns) : math.min(tStop, ns)
    f_exits(tDir, tStop, tT1, tT2, tT3, tQ1, tQ2, tQ3, done1, done2)
if strategy.position_size == 0 and not newEntry
    tDir := 0

// ───────────── מגבלה יומית + סוף סשן ─────────────
// עסקאות מנצחות / מפסידות היום: כל פוזיציה נספרת פעם אחת כשהיא נסגרת, לפי הרווח הכולל שלה (כולל יציאות חלקיות)
var int   countedCl = 0
var float npMark    = 0.0
if strategy.position_size == 0 and strategy.closedtrades > countedCl
    float pnl = strategy.netprofit - npMark
    dWin  += pnl > 0 ? 1 : 0
    dLoss += pnl < 0 ? 1 : 0
    countedCl := strategy.closedtrades
    npMark    := strategy.netprofit
if (maxWinD > 0 and dWin >= maxWinD) or (maxLossD > 0 and dLoss >= maxLossD)
    dayLock := true
float dayReal = strategy.netprofit - dayStart
float dayTot  = dayReal + strategy.openprofit
bool  lossHit = maxLoss > 0 and dayTot <= -maxLoss
bool  profHit = maxProf > 0 and dayTot >= maxProf
if (maxLoss > 0 and dayReal <= -maxLoss) or (maxProf > 0 and dayReal >= maxProf)
    dayLock := true
if closeLim and (lossHit or profHit)
    dayLock := true
    if strategy.position_size != 0
        strategy.close_all(comment = lossHit ? "מגבלת הפסד יומית" : "יעד רווח יומי")

if flatEnd and sessIdx != sessIdx[1] and sessIdx[1] > 0 and strategy.position_size != 0
    strategy.close_all(comment = "סוף סשן")

// נר הדקה שעשה את השיא/שפל של ה-SMT (בתוך נר המודל שמתחיל ב-t0)
f_swingBarTime(float price, int t0, int t1, bool isHigh) =>
    int res = na
    for i = 0 to 1500
        int bt = time[i]
        if na(bt) or bt < t0
            break
        if bt < t1 and (isHigh ? high[i] == price : low[i] == price)
            res := bt
    res

// הסגירה הקיצונית של נרות הדקה מאז זמן t0 (לבדיקת CISD בסגירת נר דקה)
f_extClose(int t0, bool wantMin) =>
    float r = na
    for i = 0 to 1500
        int bt = time[i]
        if na(bt) or bt < t0
            break
        r := na(r) ? close[i] : wantMin ? math.min(r, close[i]) : math.max(r, close[i])
    r

// סוף חלון ה-FVG: X נרות אחרי נר ה-SMT
f_winEnd(float price, int swingT, bool isHigh) =>
    int r = na
    if fvgWinTf == WIN_MODEL or (ent5 and fvgWinTf != WIN_OFF)
        r := swingT + (fvgWin + 1) * tfMs
    else if fvgWinTf == WIN_CHART
        int barMs = timeframe.in_seconds() * 1000
        int t1m   = f_swingBarTime(price, swingT, swingT + tfMs, isHigh)
        r := (na(t1m) ? swingT : t1m) + (fvgWin + 1) * barMs
    r

// המבנה הבא מעבר לשיא/שפל ה-SMT: השיא (isHigh) / השפל האחרון בגרף 5 דקות לפני נר ה-SMT
// שגבוה/נמוך ממנו, והוא הקיצון של structK נרות מכל צד
f_structStop(float price, int swingT, bool isHigh) =>
    float r = na
    int n = array.size(hT)
    if n > 2 * structK + 1 and not na(swingT) and not na(price)
        int start = -1
        for i = n - 1 to 0
            if array.get(hT, i) < swingT
                start := i
                break
        int top = math.min(start, n - 1 - structK)
        if top >= structK
            for j = top to structK
                float v = isHigh ? array.get(hHi, j) : array.get(hLo, j)
                if isHigh ? v > price : v < price
                    bool fr = true
                    for m = 1 to structK
                        float a = isHigh ? array.get(hHi, j - m) : array.get(hLo, j - m)
                        float b = isHigh ? array.get(hHi, j + m) : array.get(hLo, j + m)
                        if isHigh ? (a > v or b > v) : (a < v or b < v)
                            fr := false
                            break
                    if fr
                        r := v
                        break
    r

// נקודת הייחוס של הסטופ: SMT שבו נאסד"ק לקח את הנזילות (סוג 2) → מבנה אחד מעבר, אחרת שיא/שפל ה-SMT
f_stopRef(float sw, int swT, int typ, bool isHigh) =>
    float r = sw
    if useLive and typ == 2 and stopB == STOP_STRUCT
        float st = f_structStop(sw, swT, isHigh)
        r := na(st) ? sw : st
    r

// מחיקת הציור של סטאפ שלא הגיע ל-CISD (כשהתצוגה שלהם כבויה)
f_clearSetup() =>
    line.delete(lnSmt)
    label.delete(lbSmt)
    line.delete(lnCisd)
    0

// טקסט תווית ה-SMT: מול איזה שיא/שפל ומה רמת ה-CISD
f_smtTxt() =>
    "SMT מול " + str.tostring(stPrev, format.mintick) + " (" + str.format_time(stPrevT, "HH:mm", tz) + ")\nCISD " + str.tostring(stCisd, format.mintick)

// ───────────── סטאפ: SMT → CISD ─────────────
bool isFlat     = strategy.position_size == 0
bool allowLong  = dirMode != DIR_SHORT
bool allowShort = dirMode != DIR_LONG

bool goBear = useLive ? lvBear : bearSMT
bool goBull = useLive ? lvBull : bullSMT

// סטאפ פעיל לא מוחלף ב-SMT חדש באותו כיוון, וסטאפ שכבר עבר CISD לא מוחלף בכלל.
// SMT הפוך מחליף סטאפ שממתין ל-CISD רק אם הקיצון שלו חדש יותר, ורק אם ה-CISD של הסטאפ הקיים לא נשבר בנר הזה
// (נר ששובר CISD לשורט עושה שפל חדש — ובלי זה הוא היה "מייצר" SMT לונג שדורס את השורט).
float cNow   = cisdMode == CISD_1M ? close : cisdMode == CISD_BODY ? mC : stDir == -1 ? mL : mH
bool  brkNow = stStage == 1 and (cisdMode == CISD_1M or newHtf) and time != stArmT and not na(cNow) and (stDir == -1 ? cNow < stCisd : cNow > stCisd)
int   newBT  = useLive ? lvBSwT : mPT
int   newUT  = useLive ? lvUSwT : mPT
// הקיצון של ה-SMT ההפוך כבר מעבר לרמת ה-CISD של הסטאפ הקיים = זו תחילת שבירת המבנה שלו, לא SMT חדש
float newBSw = useLive ? lvBSw : mPH
float newUSw = useLive ? lvUSw : mPL
bool  okReplS = stStage == 1 and stDir == 1 and not brkNow and newBT > stSwingT and newBSw < stCisd
bool  okReplL = stStage == 1 and stDir == -1 and not brkNow and newUT > stSwingT and newUSw > stCisd
f_replLabel(string txt) =>
    if showDraw and showFail
        label.new(bar_index, stDir == -1 ? high : low, txt, style = stDir == -1 ? label.style_label_down : label.style_label_up, color = color.new(color.gray, 15), textcolor = color.white, size = size.small)
    0

if goBear and allowShort and isFlat and (stStage == 0 or okReplS)
    if stStage > 0
        nRepl += 1
        f_replLabel("הוחלף ב-SMT שורט")
        if not showFail
            f_clearSetup()
    nSmt     += 1
    nSmtS    += 1
    stDir    := -1
    stStage  := 1
    stSwing  := useLive ? lvBSw : mPH
    stSwingT := useLive ? lvBSwT : mPT
    stPrev   := useLive ? lvBPrev : smtRef
    stPrevT  := useLive ? lvBPrevT : smtRefT
    stCisd   := useLive ? lvBCisd : smtCisd
    stArmT   := time
    stExt    := useLive ? low : mMinL
    stRun    := useLive ? lvBRun : mMinL
    stLive   := useLive
    stLType  := lvBType
    stWinEnd := f_winEnd(stSwing, stSwingT, true)
    stStopRef := f_stopRef(stSwing, stSwingT, stLType, true)
    stCisdBT := na
    float chkB = cisdMode == CISD_1M ? f_extClose(stSwingT, true) : cisdMode == CISD_BODY ? (useLive ? mC : mMinC) : (useLive ? mL : mMinL)
    if not na(chkB) and chkB < stCisd
        stStage := 2
        stCisdT := time
        stCisdBT := cisdMode == CISD_1M ? time : mT
        nCisd   += 1
    else if not needCisd
        stStage := 2
        stCisdT := time
        stCisdBT := cisdMode == CISD_1M ? time : mT
    if showDraw
        lnSmt  := line.new(x1 = stPrevT, y1 = stPrev, x2 = stSwingT, y2 = stSwing, xloc = xloc.bar_time, color = color.red, width = 2)
        lbSmt  := label.new(x = stSwingT, y = stSwing, text = f_smtTxt(), xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.red, 20), textcolor = color.white, size = size.small)
        lnCisd := line.new(x1 = useIct ? stSwingT : stPrevT, y1 = stCisd, x2 = time, y2 = stCisd, xloc = xloc.bar_time, color = color.orange, style = line.style_dashed, width = 2)
        if not na(chkB) and chkB < stCisd
            label.new(x = time, y = stCisd, text = "CISD", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.orange, 20), textcolor = color.black, size = size.tiny)

if goBull and allowLong and isFlat and (stStage == 0 or okReplL)
    if stStage > 0
        nRepl += 1
        f_replLabel("הוחלף ב-SMT לונג")
        if not showFail
            f_clearSetup()
    nSmt     += 1
    nSmtL    += 1
    stDir    := 1
    stStage  := 1
    stSwing  := useLive ? lvUSw : mPL
    stSwingT := useLive ? lvUSwT : mPT
    stPrev   := useLive ? lvUPrev : smtRef
    stPrevT  := useLive ? lvUPrevT : smtRefT
    stCisd   := useLive ? lvUCisd : smtCisd
    stArmT   := time
    stExt    := useLive ? high : mMaxH
    stRun    := useLive ? lvURun : mMaxH
    stLive   := useLive
    stLType  := lvUType
    stWinEnd := f_winEnd(stSwing, stSwingT, false)
    stStopRef := f_stopRef(stSwing, stSwingT, stLType, false)
    stCisdBT := na
    float chkU = cisdMode == CISD_1M ? f_extClose(stSwingT, false) : cisdMode == CISD_BODY ? (useLive ? mC : mMaxC) : (useLive ? mH : mMaxH)
    if not na(chkU) and chkU > stCisd
        stStage := 2
        stCisdT := time
        stCisdBT := cisdMode == CISD_1M ? time : mT
        nCisd   += 1
    else if not needCisd
        stStage := 2
        stCisdT := time
        stCisdBT := cisdMode == CISD_1M ? time : mT
    if showDraw
        lnSmt  := line.new(x1 = stPrevT, y1 = stPrev, x2 = stSwingT, y2 = stSwing, xloc = xloc.bar_time, color = color.lime, width = 2)
        lbSmt  := label.new(x = stSwingT, y = stSwing, text = f_smtTxt(), xloc = xloc.bar_time, style = label.style_label_up, color = color.new(color.lime, 20), textcolor = color.black, size = size.small)
        lnCisd := line.new(x1 = useIct ? stSwingT : stPrevT, y1 = stCisd, x2 = time, y2 = stCisd, xloc = xloc.bar_time, color = color.orange, style = line.style_dashed, width = 2)
        if not na(chkU) and chkU > stCisd
            label.new(x = time, y = stCisd, text = "CISD", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.orange, 20), textcolor = color.black, size = size.tiny)

// תווית אבחון: למה סטאפ הסתיים בלי עסקה
var string whyNot = ""
f_endLabel(int dir, string reason) =>
    if showDraw
        label.new(bar_index, dir == -1 ? high : low, reason, style = dir == -1 ? label.style_label_down : label.style_label_up, color = color.new(color.gray, 15), textcolor = color.white, size = size.small)
    0

if stStage > 0 and isFlat
    // SMT חי: עד שה-CISD נשבר, שיא/שפל ה-SMT ממשיך להתעדכן אם המחיר ממשיך (בלי לעבור את השיא/שפל הקודם)
    if stLive and stStage == 1 and newHtf and time != stArmT
        bool newExt = stDir == -1 ? mH > stSwing and (stLType == 2 or mH <= stPrev) : mL < stSwing and (stLType == 2 or mL >= stPrev)
        if newExt
            stSwing  := stDir == -1 ? mH : mL
            stSwingT := mT
            stCisd   := useIct ? (stDir == -1 ? mURO : mDRO) : stRun
            stExt    := stDir == -1 ? mL : mH
            stWinEnd := f_winEnd(stSwing, stSwingT, stDir == -1)
            stStopRef := f_stopRef(stSwing, stSwingT, stLType, stDir == -1)
            if showDraw
                line.set_xy2(lnSmt, stSwingT, stSwing)
                label.set_xy(lbSmt, stSwingT, stSwing)
                label.set_text(lbSmt, f_smtTxt())
                line.set_y1(lnCisd, stCisd)
                if useIct
                    line.set_x1(lnCisd, stSwingT)
                line.set_y2(lnCisd, stCisd)
        stRun := stDir == -1 ? math.min(stRun, mL) : math.max(stRun, mH)
    stExt := stDir == -1 ? math.min(stExt, low) : math.max(stExt, high)
    bool beyond = stLive and stStage == 1 ? stLType == 1 and (stDir == -1 ? high > stPrev : low < stPrev) : stDir == -1 ? high > stSwing : low < stSwing
    if beyond
        // המחיר עבר את שיא/שפל ה-SMT — הסטאפ בוטל
        if stStage == 1 and not showFail
            f_clearSetup()
        else
            f_endLabel(stDir, "בוטל: המחיר עבר את השיא/שפל" + (stStage == 2 and whyNot != "" ? "\n" + whyNot : ""))
        nCxBeyond += 1
        nNoFvg    += stStage == 2 and whyNot == WHY_NOFVG ? 1 : 0
        nOutSess  += stStage == 2 and whyNot == WHY_SESS ? 1 : 0
        stStage := 0
        stDir   := 0
    else if stStage == 1
        bool chkNow = cisdMode == CISD_1M ? time != stArmT : newHtf and time != stArmT
        if chkNow
            float c = cisdMode == CISD_1M ? close : cisdMode == CISD_BODY ? mC : stDir == -1 ? mL : mH
            bool broke = stDir == -1 ? c < stCisd : c > stCisd
            if broke
                stStage := 2
                stCisdT := time
                stCisdBT := cisdMode == CISD_1M ? time : mT
                nCisd   += 1
                if showDraw
                    label.new(x = time, y = stCisd, text = "CISD", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.orange, 20), textcolor = color.black, size = size.tiny)
            else if time - math.max(stArmT, stSwingT) >= cisdWait * tfMs
                if showFail
                    f_endLabel(stDir, "בוטל: אין שבירת CISD בזמן")
                else
                    f_clearSetup()
                nCxCisd += 1
                stStage := 0
                stDir   := 0
        if showDraw and not na(lnCisd) and stStage >= 1
            line.set_x2(lnCisd, time)
    else if stStage == 2
        if time - stCisdT >= entryWait * 60000
            f_endLabel(stDir, "בוטל: עבר זמן הכניסה" + (whyNot != "" ? "\n" + whyNot : ""))
            nCxWait  += 1
            nNoFvg   += whyNot == WHY_NOFVG ? 1 : 0
            nOutSess += whyNot == WHY_SESS ? 1 : 0
            stStage := 0
            stDir   := 0

// ───────────── הצבת פקודת לימיט ב-FVG ─────────────
bool canTrade = tfOk and sessIdx > 0 and not dayLock and cSess < maxSess and cDay < maxDay and cWeek < maxWeek and cMonth < maxMonth
bool placed   = false
var float alertedLvl = na
var int   lockT      = na
var int   lockArm    = na

string whyNow = ""
if strategy.position_size == 0 and stStage == 2 and not canTrade
    whyNow := not tfOk ? "הגרף גדול מ-5 דק'" : sessIdx == 0 ? WHY_SESS : dayLock ? "נעול: מגבלה יומית" : "הגעת למקס' עסקאות"

if strategy.position_size == 0 and stStage == 2 and canTrade
    if na(lockArm) or lockArm != stArmT
        lockT   := na
        lockArm := stArmT
    float lvl  = na
    float fTop = na
    float fBot = na
    int   fT   = na
    // חלון שני: FVG מהתזוזה ששברה את ה-CISD
    int chartMs = timeframe.in_seconds() * 1000
    int w2s = fvgCisd and not na(stCisdBT) ? stCisdBT - 2 * chartMs : na
    int w2e = fvgCisd and not na(stCisdBT) ? (ent5 ? stCisdBT + (fvgWin + 1) * tfMs : math.max(stCisdT, stCisdBT + tfMs) + (fvgWin + 1) * chartMs) : na
    if stDir == -1
        [aL, aT, aB, aX] = f_pick(-1, bTop, bBot, bT, stSwing, stSwingT, stWinEnd, stExt, lockT, newBearF, w2s, w2e)
        lvl  := aL
        fTop := aT
        fBot := aB
        fT   := aX
    else
        [aL, aT, aB, aX] = f_pick(1, uTop, uBot, uT, stSwing, stSwingT, stWinEnd, stExt, lockT, newBullF, w2s, w2e)
        lvl  := aL
        fTop := aT
        fBot := aB
        fT   := aX
    lockT := fT
    if na(lvl)
        whyNow := WHY_NOFVG
    else
        float sl    = nz(stStopRef, stSwing) - stDir * slBuf * syminfo.mintick
        float risk  = math.abs(lvl - sl)
        float rTick = risk / syminfo.mintick
        float rawQ  = risk > 0 ? riskUsd / (risk * syminfo.pointvalue) : 0.0
        int   qty   = math.min(maxQty, qtyRound == RND_UP ? int(math.ceil(rawQ)) : qtyRound == RND_DOWN ? int(math.floor(rawQ)) : int(math.round(rawQ)))
        int   q1    = math.min(qty, int(math.round(qty * tp1Pct / 100)))
        int   q2    = math.min(qty - q1, int(math.round(qty * tp2Pct / 100)))
        int   q3    = qty - q1 - q2
        float t1    = lvl + stDir * tp1RR * risk
        float t2    = lvl + stDir * tp2RR * risk
        float t3    = lvl + stDir * tp3RR * risk
        float lastT = q3 > 0 ? t3 : q2 > 0 ? t2 : t1
        bool  tgtHit = cancelTgt and (stDir == -1 ? stExt <= lastT : stExt >= lastT)
        if tgtHit
            f_endLabel(stDir, "בוטל: המחיר הגיע ליעד לפני הכניסה")
            nCxTgt += 1
            stStage := 0
            stDir   := 0
        else if qty < 1
            whyNow := "הסיכון קטן מדי לחוזה אחד: חוזה = " + str.tostring(risk * syminfo.pointvalue, "#,##0") + "$"
        else if rTick < slMinT
            whyNow := "סטופ קטן מדי (" + str.tostring(rTick, "#") + " טיקים)"
        else if rTick > slMaxT
            whyNow := "סטופ גדול מדי (" + str.tostring(rTick, "#") + " טיקים)"
        else
            f_cancelSide(-stDir)
            strategy.entry(stDir == 1 ? "Long" : "Short", stDir == 1 ? strategy.long : strategy.short, qty = qty, limit = lvl)
            f_exits(stDir, sl, t1, t2, t3, q1, q2, q3, false, false)
            placed := true
            pDir   := stDir
            pEntry := lvl
            pStop  := sl
            pQty   := qty
            pQ1    := q1
            pQ2    := q2
            pQ3    := q3
            pT1    := t1
            pT2    := t2
            pT3    := t3
            if showDraw
                // התיבה מתחילה ברגע שהלימיט נשלח (לא בזמן שה-FVG נוצר) — נגיעה לפני התיבה = הפקודה עוד לא הייתה בשוק
                string fTxt = "לימיט " + str.tostring(lvl, format.mintick) + " · " + str.tostring(qty) + " חוזים · FVG מ-" + str.format_time(fT, "HH:mm", tz) + (nz(stStopRef, stSwing) != stSwing ? " · סטופ מבנה " + str.tostring(sl, format.mintick) : "")
                if na(bxFvg) or bxArm != stArmT
                    bxT0  := time
                    bxFvg := box.new(left = bxT0, top = fTop, right = time, bottom = fBot, xloc = xloc.bar_time, bgcolor = color.new(color.orange, 80), border_color = color.new(color.orange, 40))
                    lbFvg := label.new(x = bxT0, y = stDir == -1 ? fTop : fBot, text = fTxt, xloc = xloc.bar_time, style = stDir == -1 ? label.style_label_lower_left : label.style_label_upper_left, color = color.new(color.orange, 30), textcolor = color.black, size = size.tiny)
                    bxArm := stArmT
                else
                    box.set_lefttop(bxFvg, bxT0, fTop)
                    box.set_rightbottom(bxFvg, time, fBot)
                    label.set_xy(lbFvg, bxT0, stDir == -1 ? fTop : fBot)
                    label.set_text(lbFvg, fTxt)
            if na(alertedLvl) or lvl != alertedLvl
                alert(str.format("{0} LIMIT @ {1} | SL {2} | TP {3} | Qty {4}", stDir == 1 ? "LONG" : "SHORT", str.tostring(lvl, format.mintick), str.tostring(sl, format.mintick), str.tostring(lastT, format.mintick), qty), alert.freq_once_per_bar_close)
                alertedLvl := lvl

if whyNow != ""
    whyNot := whyNow
if stStage == 0
    whyNot := ""

if not placed and strategy.position_size == 0
    f_cancelSide(1)
    f_cancelSide(-1)

// ───────────── תצוגה ─────────────
bool inTrade = strategy.position_size != 0 and tDir != 0
plot(inTrade ? tEntry : placed ? pEntry : na, "כניסה", color.new(color.white, 30), 1, plot.style_linebr)
plot(inTrade ? tStop : placed ? pStop : na, "סטופ", color.red, 2, plot.style_linebr)
plot(inTrade and tQ1 > 0 ? tT1 : placed and pQ1 > 0 ? pT1 : na, "TP1", color.teal, 1, plot.style_linebr)
plot(inTrade and tQ2 > 0 ? tT2 : placed and pQ2 > 0 ? pT2 : na, "TP2", color.teal, 1, plot.style_linebr)
plot(inTrade and tQ3 > 0 ? tT3 : placed and pQ3 > 0 ? pT3 : na, "TP3", color.lime, 2, plot.style_linebr)
bgcolor(sessIdx > 0 ? color.new(color.blue, 94) : na, title = "סשן פעיל")

f_row(table t, int r, string k, string v, color c) =>
    table.cell(t, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 1, r, v, text_color = c, text_size = size.small)

var table tbl = table.new(position.top_right, 2, 22, bgcolor = color.new(#131722, 10), border_color = color.new(color.gray, 70), border_width = 1)
if showTbl and barstate.islast
    string side   = stDir == -1 ? "שורט" : "לונג"
    string status = strategy.position_size > 0 ? "בעסקת לונג" : strategy.position_size < 0 ? "בעסקת שורט" : stStage == 1 ? side + ": ממתין ל-CISD" : stStage == 2 ? (placed ? side + ": לימיט ב-FVG" : side + ": " + (whyNow != "" ? whyNow : "מחפש FVG")) : "מחפש SMT"
    f_row(tbl, 0, "סטטוס", status, color.white)
    f_row(tbl, 1, "רווח/הפסד היום", str.tostring(dayTot, "#,##0.00") + " $", dayTot >= 0 ? color.lime : color.red)
    f_row(tbl, 2, "עסקאות בסשן", str.tostring(cSess) + " / " + str.tostring(maxSess), color.white)
    f_row(tbl, 3, "עסקאות היום", str.tostring(cDay) + " / " + str.tostring(maxDay), color.white)
    f_row(tbl, 4, "עסקאות השבוע", str.tostring(cWeek) + " / " + str.tostring(maxWeek), color.white)
    f_row(tbl, 5, "עסקאות החודש", str.tostring(cMonth) + " / " + str.tostring(maxMonth), color.white)
    f_row(tbl, 6, "מסחר היום", dayLock ? "נעול (מגבלה יומית)" : "פתוח", dayLock ? color.orange : color.lime)
    f_row(tbl, 7, "טיימפריים", tfOk ? "תקין" : "הגרף חייב להיות 5 דק' או פחות", tfOk ? color.lime : color.red)
    f_row(tbl, 8, "── משפך סטאפים ──", "", color.silver)
    f_row(tbl, 9, "SMT-ים שזוהו", str.tostring(nSmt), color.white)
    f_row(tbl, 10, "עברו CISD", str.tostring(nCisd), color.white)
    f_row(tbl, 11, "נכנסו לעסקה", str.tostring(nFilled), color.lime)
    f_row(tbl, 12, "בוטל: אין CISD בזמן", str.tostring(nCxCisd), color.orange)
    f_row(tbl, 13, "בוטל: המחיר עבר את השיא/שפל", str.tostring(nCxBeyond), color.orange)
    f_row(tbl, 14, "בוטל: עבר זמן הכניסה", str.tostring(nCxWait), color.orange)
    f_row(tbl, 15, "בוטל: הגיע ליעד לפני כניסה", str.tostring(nCxTgt), color.orange)
    f_row(tbl, 16, "הוחלף ב-SMT חדש", str.tostring(nRepl), color.orange)
    f_row(tbl, 17, "מתוכם: אין FVG / מחוץ לסשן", str.tostring(nNoFvg) + " / " + str.tostring(nOutSess), color.orange)
    f_row(tbl, 18, "SMT לונג / שורט", str.tostring(nSmtL) + " / " + str.tostring(nSmtS), color.white)
    f_row(tbl, 19, "עסקאות לונג / שורט", str.tostring(nFillL) + " / " + str.tostring(nFillS), color.lime)
    f_row(tbl, 20, "היום: מנצחות / מפסידות", str.tostring(dWin) + " / " + str.tostring(dLoss), color.white)
    f_row(tbl, 21, "גרסת קוד", "v35", color.yellow)
